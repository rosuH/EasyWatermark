context platform=ios
open me.rosuh.easywatermark.ios --relaunch
press id="store-seed-editor"
wait id="sharedComposeSaveButton" 90000
press id="editorTab-1"
wait id="editorControl-TileMode"
press label="单个"
wait label="单个"
press id="sharedComposeWatermarkPreview"
wait id="sharedComposeWatermarkPreview"
close
