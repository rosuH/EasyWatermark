context platform=ios
env WATERMARK="EWM COMBO"
open me.rosuh.easywatermark.ios
wait id="sharedComposeSaveButton"
press id="watermarkTextContent"
wait id="watermarkTextEditField"
fill id="watermarkTextEditField" "${WATERMARK}"
press id="watermarkTextConfirm"
wait id="sharedComposeSaveButton"
press id="editorTab-1"
wait id="editorOption-TextSize"
press id="editorOption-TextSize"
wait id="sliderTrack"
press id="sliderTrack"
press id="editorOption-Color"
wait id="colorSwatch-FF000000"
press id="colorSwatch-FF000000"
press id="editorOption-Alpha"
wait id="editorControl-Alpha"
press id="sliderTrack"
press id="sharedComposeSaveButton"
wait text "Output format"
press "label=\"PNG, PNG\""
press id="sharedComposeExportPrimary"
wait id="sharedComposeExportCounts"
close
