context platform=android
open me.rosuh.easywatermark.debug --relaunch
wait "label=\"Choose Images\"" 60000
wait absent label="Save" 5000
wait absent label="Version" 5000
press label="About"
wait label="Version" 60000
wait absent "text=\"Coil\"" 5000
scroll down
scroll down
scroll down
press "label=\"Follow wallpaper colors\""
wait "label=\"Follow wallpaper colors\""
press label="Back"
wait "label=\"Choose Images\""
wait absent label="Save" 5000
wait absent label="Version" 5000
close
