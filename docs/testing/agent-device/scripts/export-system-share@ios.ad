context platform=ios
open me.rosuh.easywatermark.ios --relaunch
press id="store-seed-editor"
wait id="sharedComposeSaveButton" 90000
press id="sharedComposeSaveButton"
wait id="sharedComposeExportSheet" 20000
press "label=\"PNG, PNG\""
press id="sharedComposeExportPrimary"
wait id="sharedComposeExportCounts" 30000
wait "label=\"分享\"" 60000
press "label=\"分享\""
close
