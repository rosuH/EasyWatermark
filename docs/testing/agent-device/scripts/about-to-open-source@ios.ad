context platform=ios
open me.rosuh.easywatermark.ios --relaunch
wait "id=\"launchPickImageButton\" label=\"Choose Images\" visible"
wait absent id="sharedComposeSaveButton" 5000
wait absent id="aboutBack" 5000
press id="launchAboutButton"
wait label="Version"
wait absent id="openSourceBack" 5000
press label="Open source licenses"
wait "id=\"openSourceContentMaxWidth\" visible"
press id="openSourceBack"
wait label="Version"
wait absent id="openSourceBack" 5000
press id="aboutBack"
wait "id=\"launchPickImageButton\" label=\"Choose Images\" visible"
wait absent id="sharedComposeSaveButton" 5000
wait absent id="aboutBack" 5000
close
