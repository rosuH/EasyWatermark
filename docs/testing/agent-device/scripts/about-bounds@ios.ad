context platform=ios
open me.rosuh.easywatermark.ios --relaunch
wait "id=\"launchPickImageButton\" label=\"选择图片\" visible" 20000
press id="launchAboutButton"
wait label="版本"
scroll down
scroll down
scroll down
press "role=switch label=\"Show Bounds\""
wait "role=switch label=\"Show Bounds\""
press id="aboutBack"
wait "id=\"launchPickImageButton\" label=\"选择图片\" visible"
close
