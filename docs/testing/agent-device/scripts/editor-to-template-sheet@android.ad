context platform=android
env TEMPLATE="EWM TEMPLATE AGENT DEVICE"
open me.rosuh.easywatermark.debug
wait label="Save"
press label="Content"
wait label="Text"
press label="Text"
wait "label=\"Edit watermark\""
press "label=\"Template List\""
wait label="Add"
press label="Add"
wait "label=\"Edit watermark\""
fill editable=true "${TEMPLATE}"
press label="Confirm"
wait text "EWM TEMPLATE AGENT DEVICE"
close
