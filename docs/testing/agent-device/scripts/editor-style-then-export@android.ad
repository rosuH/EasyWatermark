context platform=android
env WATERMARK="EWM COMBO"
open me.rosuh.easywatermark.debug
wait label="Save"
press label="内容"
wait label="文字"
press label="👋图片仅供测试，请勿作其他用途"
wait label="编辑水印"
fill editable=true "${WATERMARK}"
press label="确认"
wait label="Save"
press label="样式"
wait label="大小"
press label="大小"
wait id="sliderTrack"
press id="sliderTrack"
press label="颜色"
wait "label=\"Text color #FF000000\""
press "label=\"Text color #FF000000\""
press label="不透明度"
wait id="sliderTrack"
press id="sliderTrack"
press label="Save"
wait label="输出格式"
press text="PNG"
press label="导出到相册"
wait text "succeeded"
close
