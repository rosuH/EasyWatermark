context platform=android
env WATERMARK="EWM COMBO"
open me.rosuh.easywatermark.debug
press label="Content"
wait label="Text"
press "label=\"👋 DO NOT REDISTRIBUTE\""
wait "label=\"Edit watermark\""
fill editable=true "${WATERMARK}"
press label="Confirm"
wait label="Save"
wait absent label="Version" 5000
press label="Style"
wait label="Size"
press value="Size"
wait role="seekbar"
press role="seekbar"
press value="Color"
wait label="black"
press label="black"
press value="Alpha"
wait role="seekbar"
press role="seekbar"
press label="Save"
wait "label=\"Output format\""
press value="PNG"
press value="Export to the album"
wait text "succeeded"
close
