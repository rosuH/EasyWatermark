context platform=ios
open me.rosuh.easywatermark.ios --relaunch
wait "id=\"launchPickImageButton\" label=\"选择图片\" visible" 20000
wait absent id="sharedComposeSaveButton" 5000
wait absent id="aboutBack" 5000
press id="launchPickImageButton"
wait "id=\"iosLibraryReadUpsellContinue\" visible" 20000
press id="iosLibraryReadUpsellContinue"
close
