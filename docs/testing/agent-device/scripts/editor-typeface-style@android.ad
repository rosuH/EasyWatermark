context platform=android
open me.rosuh.easywatermark.debug
press label="Style"
wait label="TileMode"
wait id="editorOption-TextTypeFace"
press id="editorOption-TextTypeFace"
wait id="editorControl-TextTypeFace"
# Android puts choice-1 on the parent; Bold also labels a separate View.
wait "role=\"textview\" label=\"Bold\""
press "role=\"textview\" label=\"Bold\""
wait "role=\"textview\" label=\"Bold\""
# SDK 0.21.2 drops Android checked: verify Bold checked / Normal unchecked in raw layout.
close
