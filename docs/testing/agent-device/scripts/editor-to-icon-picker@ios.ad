context platform=ios
open me.rosuh.easywatermark.ios
wait "id=\"sharedComposeSaveButton\" label=\"Save\" visible"
wait absent id="aboutBack" 5000
wait absent id="openSourceBack" 5000
press id="editorTab-0"
wait id="editorOption-Icon"
press id="editorOption-Icon"
wait "label=\"Choose picture\""
press "label=\"Choose picture\""
wait "label=\"Choose picture\""
close
